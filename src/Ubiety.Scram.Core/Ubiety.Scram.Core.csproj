<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- The package version comes from GitVersion via the Pack target; see build/Build.cs. -->
  <PropertyGroup>
    <Authors>Dieter Lunn</Authors>
    <PackageDescription>Implementation of SCRAM for .NET</PackageDescription>
    <PackageIcon>icon128.png</PackageIcon>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://scram.ubiety.ca</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ubiety/Ubiety.Scram.Core</RepositoryUrl>
    <PackageTags>ubiety;scram;challenge-response;authentication;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon128.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="Ubiety.Stringprep.Core" />
    <PackageReference Include="Ubiety.StyleCop" PrivateAssets="All" />
  </ItemGroup>

</Project>
