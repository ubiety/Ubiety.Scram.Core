{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Ubiety.Scram.Core",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Ubiety.Scram.Core",
      "_appTitle": "Ubiety.Scram.Core",
      "_appFooter": "Ubiety.Scram.Core &mdash; Unlicense",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/ubiety/Ubiety.Scram.Core",
        "branch": "develop"
      }
    },
    "sitemap": {
      "baseUrl": "https://scram.ubiety.ca"
    }
  }
}
